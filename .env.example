# Environment variables for the production-agentic-rag API Service
# Note: These values can be overridden by the environment section in compose.yml

# Application Settings
DEBUG=true
ENVIRONMENT=development

# PostgreSQL Database
# In Docker: hostname `postgres`, port 5432. On host (uv run): localhost and the published port from compose.yml (5433).
POSTGRES_DATABASE_URL=postgresql+psycopg2://production_agentic_rag_user:production_agentic_rag_password@postgres:5432/production_agentic_rag_db
# POSTGRES_DATABASE_URL=postgresql+psycopg2://production_agentic_rag_user:production_agentic_rag_password@localhost:5433/production_agentic_rag_db

# External Services
OPENSEARCH__HOST=http://opensearch:9200
# OPENSEARCH__HOST=http://localhost:9201
# arXiv API Configuration
ARXIV__MAX_RESULTS=15
ARXIV__BASE_URL=https://export.arxiv.org/api/query
ARXIV__PDF_CACHE_DIR=./data/arxiv_pdfs
ARXIV__RATE_LIMIT_DELAY=3.0
ARXIV__TIMEOUT_SECONDS=30
ARXIV__SEARCH_CATEGORY=cs.AI
ARXIV__DOWNLOAD_MAX_RETRIES=3
ARXIV__DOWNLOAD_RETRY_DELAY_BASE=5.0
ARXIV__MAX_CONCURRENT_DOWNLOADS=5
ARXIV__MAX_CONCURENT_PARSING=1

# PDF Parser Configuration
PDF_PARSER__MAX_PAGES=60
PDF_PARSER__MAX_FILE_SIZE_MB=20
PDF_PARSER__DO_OCR=false
PDF_PARSER__DO_TABLE_STRUCTURE=true

# OpenSearch Configuration (Single hybrid index for all search types)
OPENSEARCH__INDEX_NAME=production-agentic-rag-papers
OPENSEARCH__CHUNK_INDEX_SUFFIX=chunks
OPENSEARCH__MAX_TEXT_SIZE=1000000

# Vector Search Settings
OPENSEARCH__VECTOR_DIMENSION=1024
OPENSEARCH__VECTOR_SPACE_TYPE=cosinesimil

# Hybrid Search Settings  
OPENSEARCH__RRF_PIPELINE_NAME=hybrid-rrf-pipeline
OPENSEARCH__HYBRID_SEARCH_SIZE_MULTIPLIER=2


# Text Chunking Settings
CHUNKING__CHUNK_SIZE=600
CHUNKING__CHUNK_SIZE=100
CHUNKING__MIN_CHUNK_SIZE=100
CHUNKING__SECTION_BASED=true

# Jina AI Embeddings (Required for hybrid search)
JINA_API_KEY=your_jina_api_key_here

# LLM via OpenRouter (OpenAI-compatible Chat Completions) — RAG, agents
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: OpenRouter rankings / attribution (https://openrouter.ai/docs)
# OPENROUTER_HTTP_REFERER=https://github.com/your/repo
# OPENROUTER_APP_TITLE=production-agentic-rag-api
# Trả phí — ví dụ model giá thấp; xem https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TRANSLATION_MODEL=google/gemini-2.0-flash-001
# Legacy env name (same as OPENROUTER_TRANSLATION_MODEL):
# TRANSLATION_MODEL=google/gemini-2.0-flash-001
# HTTP timeout for LLM requests (seconds); legacy env name still works:
LLM_HTTP_TIMEOUT_SECONDS=300
# OLLAMA_TIMEOUT=300

# Langfuse v3 — use LANGFUSE_* (one underscore after LANGFUSE). Create keys in UI: Settings → API keys for this project.
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LANGFUSE_FLUSH_AT=15
LANGFUSE_FLUSH_INTERVAL=1.0
LANGFUSE_DEBUG=true

# Langfuse Server Configuration (for docker-compose)
# WARNING: Change these values in production! These are development defaults.
LANGFUSE_NEXTAUTH_SECRET=changeme-v3-nextauth-secret-min-32-chars-recommended
LANGFUSE_SALT=changeme-v3-salt-min-32-chars-recommended-for-security
LANGFUSE_ENCRYPTION_KEY=changeme-v3-encryption-key-64-hex-chars-required-see-docs
LANGFUSE_REDIS_PASSWORD=langfuse_redis_password
LANGFUSE_MINIO_ACCESS_KEY=langfuse_minio
LANGFUSE_MINIO_SECRET_KEY=langfuse_minio_secret

# Langfuse UI bootstrap: compose.yml sets LANGFUSE_INIT_ORG_ID + LANGFUSE_INIT_PROJECT_ID (required in v3).
# Login: admin@example.com / admin123 (after fresh Postgres volume). If init was skipped before, reset volume:
#   docker compose stop langfuse-web langfuse-worker && docker volume rm <project>_langfuse_v3_postgres_data
#
# If Langfuse UI errors with Unknown table `events_core` (ClickHouse migrations never applied), reset ClickHouse volume:
#   docker compose stop clickhouse langfuse-web langfuse-worker && docker volume rm production-agentic-rag_clickhouse_data_v2 && docker compose up -d clickhouse langfuse-web langfuse-worker

# Redis Cache Configuration
REDIS__HOST=redis
REDIS__PORT=6379
REDIS__PASSWORD=X74g/aCN5aAyMPA4PKNwww==
REDIS__DB=0
REDIS__TTL_HOURS=6

# Airflow Settings
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=true
AIRFLOW__HOME=/opt/airflow
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://production_agentic_rag_user:production_agentic_rag_password@postgres:5432/production_agentic_rag_db